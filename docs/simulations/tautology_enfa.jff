<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<structure>
  <type>fa</type>
  <automaton>

    <state id="0" name="q0">
      <x>50.0</x>
      <y>100.0</y>
      <initial/>
    </state>

    <state id="1" name="q1">
      <x>150.0</x>
      <y>100.0</y>
    </state>

    <state id="2" name="q2">
      <x>250.0</x>
      <y>100.0</y>
    </state>

    <state id="3" name="q3">
      <x>350.0</x>
      <y>100.0</y>
    </state>

    <state id="4" name="q4">
      <x>450.0</x>
      <y>100.0</y>
    </state>

    <state id="5" name="q5">
      <x>550.0</x>
      <y>100.0</y>
    </state>

    <state id="6" name="q6">
      <x>650.0</x>
      <y>100.0</y>
    </state>

    <state id="7" name="q7">
      <x>750.0</x>
      <y>100.0</y>
    </state>

    <state id="8" name="q8">
      <x>850.0</x>
      <y>100.0</y>
    </state>

    <state id="9" name="q9">
      <x>950.0</x>
      <y>100.0</y>
    </state>

    <state id="10" name="q10">
      <x>1050.0</x>
      <y>100.0</y>
      <final/>
    </state>

    <!-- Scan loops -->

    <transition>
      <from>0</from>
      <to>0</to>
      <read>a</read>
    </transition>

    <transition>
      <from>0</from>
      <to>0</to>
      <read>b</read>
    </transition>

    <transition>
      <from>0</from>
      <to>0</to>
      <read>c</read>
    </transition>

    <transition>
      <from>0</from>
      <to>0</to>
      <read>h</read>
    </transition>

    <transition>
      <from>0</from>
      <to>0</to>
      <read>e</read>
    </transition>

    <transition>
      <from>0</from>
      <to>0</to>
      <read>l</read>
    </transition>

    <transition>
      <from>0</from>
      <to>0</to>
      <read>o</read>
    </transition>

    <!-- ε transition -->

    <transition>
      <from>0</from>
      <to>1</to>
      <read/>
    </transition>

    <!-- Pattern: 'OR'x'='x -->

    <transition>
      <from>1</from>
      <to>2</to>
      <read>'</read>
    </transition>

    <transition>
      <from>2</from>
      <to>3</to>
      <read>O</read>
    </transition>

    <transition>
      <from>3</from>
      <to>4</to>
      <read>R</read>
    </transition>

    <transition>
      <from>4</from>
      <to>5</to>
      <read>'</read>
    </transition>

    <transition>
      <from>5</from>
      <to>6</to>
      <read>x</read>
    </transition>

    <transition>
      <from>6</from>
      <to>7</to>
      <read>'</read>
    </transition>

    <transition>
      <from>7</from>
      <to>8</to>
      <read>=</read>
    </transition>

    <transition>
      <from>8</from>
      <to>9</to>
      <read>'</read>
    </transition>

    <transition>
      <from>9</from>
      <to>10</to>
      <read>x</read>
    </transition>

    <!-- Accept remaining text -->

    <transition>
      <from>10</from>
      <to>10</to>
      <read>a</read>
    </transition>

    <transition>
      <from>10</from>
      <to>10</to>
      <read>b</read>
    </transition>

    <transition>
      <from>10</from>
      <to>10</to>
      <read>c</read>
    </transition>

    <transition>
      <from>10</from>
      <to>10</to>
      <read>x</read>
    </transition>

    <transition>
      <from>10</from>
      <to>10</to>
      <read>'</read>
    </transition>

  </automaton>
</structure>