<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<structure>
<type>fa</type>
<automaton>

<state id="0" name="q0">
<x>100</x><y>100</y>
<initial/>
</state>

<state id="1" name="q1">
<x>200</x><y>100</y>
</state>

<state id="2" name="q2">
<x>300</x><y>100</y>
</state>

<state id="3" name="q3">
<x>400</x><y>100</y>
</state>

<state id="4" name="q4">
<x>500</x><y>100</y>
</state>

<state id="5" name="q5">
<x>600</x><y>100</y>
</state>

<state id="6" name="q6">
<x>700</x><y>100</y>
<final/>
</state>

<!-- Keep scanning -->
<transition><from>0</from><to>0</to><read>a</read></transition>
<transition><from>0</from><to>0</to><read>b</read></transition>
<transition><from>0</from><to>0</to><read>c</read></transition>

<!-- Start pattern -->
<transition><from>0</from><to>1</to><read>.</read></transition>

<transition><from>1</from><to>2</to><read>.</read></transition>
<transition><from>2</from><to>3</to><read>/</read></transition>
<transition><from>3</from><to>4</to><read>.</read></transition>
<transition><from>4</from><to>5</to><read>.</read></transition>
<transition><from>5</from><to>6</to><read>/</read></transition>

<!-- Accept remainder -->
<transition><from>6</from><to>6</to><read>a</read></transition>
<transition><from>6</from><to>6</to><read>b</read></transition>
<transition><from>6</from><to>6</to><read>c</read></transition>
<transition><from>6</from><to>6</to><read>.</read></transition>
<transition><from>6</from><to>6</to><read>/</read></transition>

</automaton>
</structure>